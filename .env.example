# Notion internal integration token (start: ntn_...)
# Maak aan op https://www.notion.so/profile/integrations
NOTION_TOKEN=

# Wordt ingevuld door `npm run setup:notion`
NOTION_DATABASE_ID=

# Anthropic API key voor auto-tagging (https://platform.claude.com)
ANTHROPIC_API_KEY=

# Wachtwoord voor de vault. Verplicht zodra de app online staat;
# laat je hem leeg, dan is de vault lokaal open en online dicht.
VAULT_PASSWORD=

# Optioneel: goedkoper model voor tagging (bv. claude-haiku-4-5)
VAULT_TAGGING_MODEL=claude-opus-5

# Optioneel: fine-grained GitHub-token (Actions: Read and write op nestors-vault).
# Staat deze ingesteld, dan start elke upload en de knop "Ververs nu" meteen de
# tag-workflow op GitHub Actions (Claude-abonnement, geen API-tegoed).
GITHUB_ACTIONS_TOKEN=
